# SignalEdge OS — Free-First Architecture Environment Configuration

# Server & Runtime
PORT=3000
NODE_ENV=development
JWT_SECRET=signaledge_super_secret_jwt_key_2026_change_in_production
MAX_FILE_UPLOAD_BYTES=5242880
CLIENT_URL=http://localhost:3000

# Primary AI Provider (Optional: Google Gemini API)
# If omitted, the platform uses deterministic financial rule engine offline
GEMINI_API_KEY=

# Optional Financial Data Providers
# The system operates free-first without these, but supports these keys for enhanced global coverage
ALPHAVANTAGE_API_KEY=
FMP_API_KEY=
FINNHUB_API_KEY=
TWELVE_DATA_API_KEY=

# Optional Cache Provider (Upstash Redis REST)
# If omitted, the platform uses built-in in-memory LRU cache
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Provider Routing Preferences (Optional)
FINANCIAL_PRIMARY=yahoo_finance
FINANCIAL_SECONDARY=official_filings
AI_PRIMARY=gemini
CACHE_PROVIDER=in_memory
